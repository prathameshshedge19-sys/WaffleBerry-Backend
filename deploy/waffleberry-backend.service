[Unit]
Description=LegaRya FastAPI backend
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=waffleberry
Group=waffleberry
WorkingDirectory=/home/waffleberry/WaffleBerry-Backend/backend
EnvironmentFile=/home/waffleberry/WaffleBerry-Backend/backend/.env
ExecStart=/home/waffleberry/WaffleBerry-Backend/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
