# Waffle Berry Backend Environment Variables
# Copy this file to .env and update with your values

APP_NAME="Waffle Berry Backend"
DEBUG=true

# Local development database
DATABASE_URL=sqlite:///./waffle_berry.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://waffleberry:change-me@localhost:5432/waffleberry

# API
API_V1_PREFIX=/api/v1

# Comma-separated, explicit browser origins. Do not use * in production.
# Keep local origins for development; replace/add the deployed Vercel origin.
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5500,http://localhost:5500

# JWT
# Generate a long random value for every deployed environment.
# Never commit the populated .env file.
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI provider implementation
AI_PROVIDER=openai

# Provider model identifier; change this to switch models.
AI_MODEL=replace-with-provider-model-name

# Speech-to-text model. Raw audio is processed transiently and not persisted.
AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Text-to-speech defaults. Generated audio is returned directly and not stored.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_MALE_VOICE=cedar
OPENAI_TTS_FEMALE_VOICE=marin
DEFAULT_STANDARD_VOICE_PROFILE=standard_female
OPENAI_TTS_FORMAT=mp3
MESSAGE_SPEECH_ENGINE=tts
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_TIMEOUT_SECONDS=60
OPENAI_REALTIME_MAX_AUDIO_BYTES=26214400
OPENAI_REALTIME_OUTPUT_FORMAT=audio/pcm
REALTIME_FALLBACK_TO_TTS=true
TTS_MAX_TEXT_CHARACTERS=4096
TTS_TIMEOUT_SECONDS=60

# Credential used only by the OpenAI provider.
OPENAI_API_KEY=replace-with-provider-api-key

# Provider connection and response timeouts, in seconds.
AI_CONNECT_TIMEOUT_SECONDS=10
AI_READ_TIMEOUT_SECONDS=90

# Transient provider retry policy.
AI_RETRY_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=0.25
AI_RETRY_MAX_DELAY_SECONDS=2
AI_RETRY_JITTER_SECONDS=0.15

# Total system, history, and latest-user messages sent to the provider.
AI_MAX_CONTEXT_MESSAGES=24

# Companion approved-memory prompt budget (Phase 6.7.5)
MEMORY_GROUNDING_MAX_MEMORIES=8
MEMORY_GROUNDING_MAX_ESTIMATED_TOKENS=1500
MEMORY_GROUNDING_MAX_CHARACTERS=6000
