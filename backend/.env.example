APP_NAME=LegaRya Backend
LEGARYA_DEBUG=false
DATABASE_URL=postgresql://legarya:change-me@localhost:5432/legarya
CORS_ORIGINS=https://waffleberry.app,https://www.waffleberry.app
FRONTEND_BASE_URL=https://www.waffleberry.app
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_CODE_EXPIRE_MINUTES=10
OPENAI_API_KEY=
VOICE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_MAX_UPLOAD_BYTES=26214400
VOICE_MAX_RECORDING_SECONDS=300
VOICE_MAX_TTS_CHARACTERS=4096
MEDIA_ENABLED=false
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_STORAGE_PATH=./media-storage
# Production media requires private S3 plus SSE-C; never commit real values.
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_SSE_CUSTOMER_KEY=
MEDIA_S3_SSE_CUSTOMER_KEY_ID=
MEDIA_MAX_PHOTO_BYTES=20971520
MEDIA_MAX_DOCUMENT_BYTES=52428800
MEDIA_MAX_AUDIO_BYTES=104857600
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_UPLOAD_EXPIRE_SECONDS=3600
MEDIA_INTELLIGENCE_MODEL=gpt-5.6-mini
AI_MODEL=gpt-5.6-luna
MEMORY_EXTRACTION_MODEL=gpt-5.6-luna
MEMORY_EXTRACTION_REASONING_EFFORT=low
MEMORY_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_EMBEDDING_DIMENSIONS=256
MEMORY_EMBEDDING_VERSION=v1
MEMORY_RETRIEVAL_TOP_K=6
MEMORY_RETRIEVAL_THRESHOLD=0.28
MEMORY_DUPLICATE_THRESHOLD=0.94
AI_REASONING_EFFORT=low
GOOGLE_WEB_CLIENT_ID=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
