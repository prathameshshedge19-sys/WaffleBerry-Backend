[Unit]
Description=Check backup expiry/journal volume and retry privacy alert delivery

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/home/waffleberry/WaffleBerry-Backend/backend/.env
EnvironmentFile=/etc/legarya-privacy-monitor.env
ExecStart=/usr/bin/python3 -B /opt/legarya-privacy/deletion_alerts.py monitor
StateDirectory=legarya-deletion-alerts
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
TimeoutStartSec=75
