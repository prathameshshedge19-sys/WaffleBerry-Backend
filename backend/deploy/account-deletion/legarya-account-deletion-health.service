[Unit]
Description=LegaRya deletion completion deadline monitor
OnFailure=legarya-deletion-alert.service

[Service]
Type=oneshot
User=waffleberry
Group=waffleberry
WorkingDirectory=/home/waffleberry/WaffleBerry-Backend/backend
EnvironmentFile=/home/waffleberry/WaffleBerry-Backend/backend/.env
EnvironmentFile=/etc/legarya-privacy-monitor.env
ExecStart=/home/waffleberry/WaffleBerry-Backend/backend/.venv/bin/python -m app.services.account_deletion_worker health
NoNewPrivileges=yes
PrivateTmp=yes
TimeoutStartSec=45
